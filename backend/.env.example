# WebSage AI — Backend Configuration Template
# Copy this file to backend/.env and insert your real keys.
# NEVER commit backend/.env to source control!

# Environment mode: 'development', 'production', or 'test'
ENVIRONMENT=development

# Active AI Provider: 'groq' or 'gemini'
AI_PROVIDER=gemini

# Gemini Provider Configuration (Google AI Studio)
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Groq Provider Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Enable mock AI responses for testing when no real API key is configured (true/false)
USE_MOCK_AI=true

# Security & Resource Limits (Enforces Requirements v1.2)
MAX_URL_LENGTH=2048
MAX_REDIRECTS=3
MAX_RESPONSE_BYTES=2097152
MAX_EXTRACTED_CHARS=20000
FETCH_TIMEOUT_SECONDS=10.0
AI_TIMEOUT_SECONDS=30.0

# Rate Limiting & Proxy Configuration
# Format: count/minute, count/hour, etc. (e.g. 10/minute)
RATE_LIMIT_SUMMARIZE=10/minute
# Set to true ONLY when deployed behind a trusted reverse proxy (e.g. Render, Cloudflare)
# that reliably sets or overwrites client IP headers. Leave false for local dev.
TRUST_PROXY_HEADERS=false

# CORS Allowed Origins (comma-separated)
# In production, set to your specific deployed frontend origin. Avoid wildcard '*' in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://web-sage-ai.vercel.app
